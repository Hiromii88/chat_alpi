<h1 class="text-3xl font-bold mb-6">お問い合わせ</h1>

<% if @contact.errors.any? %>
  <div class="bg-red-100 text-red-800 p-4 rounded mb-4">
    <ul class="list-disc pl-5">
      <% @contact.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @contact, local: true, data: { turbo: false } do |f| %>
  <div class="mb-4">
    <%= f.label :name, "お名前", class: "block text-sm font-semibold mb-1" %>
    <%= f.text_field :name, class: "w-full border rounded p-2" %>
  </div>

  <div class="mb-4">
    <%= f.label :email, "メールアドレス", class: "block text-sm font-semibold mb-1" %>
    <%= f.email_field :email, class: "w-full border rounded p-2" %>
  </div>

  <div class="mb-4">
    <%= f.label :subject, "件名", class: "block text-sm font-semibold mb-1" %>
    <%= f.text_field :subject, class: "w-full border rounded p-2" %>
  </div>

  <div class="mb-4">
    <%= f.label :message, "お問い合わせ内容", class: "block text-sm font-semibold mb-1" %>
    <%= f.text_area :message, rows: 6, class: "w-full border rounded p-2" %>
  </div>

  <div>
    <%= f.submit "送信する", class: "bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600" %>
  </div>
<% end %>
